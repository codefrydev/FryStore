<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:PdfEditorApp.Plugins.Snake"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="328" d:DesignHeight="440"
             x:Class="PdfEditorApp.Plugins.Snake.SnakeGameView"
             x:DataType="local:SnakeGameViewModel"
             Focusable="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="14" Width="300">

        <!-- 1. Header Info: Score, Best Score, and Game State Pill -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <!-- Score & Best Score Counter Badges -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border CornerRadius="{StaticResource M3ShapeCornerFull}"
                        Background="{DynamicResource M3SurfaceContainerHighBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Score" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Score}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource M3PrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="{StaticResource M3ShapeCornerFull}"
                        Background="{DynamicResource M3SurfaceContainerLowBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Best" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HighScore}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Status Indicator Pill -->
            <Border Grid.Column="1"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding State}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource M3PrimaryBrush}"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 2. Game Canvas Area -->
        <Border Grid.Row="1"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                ClipToBounds="True"
                Width="296" Height="296">
            <Panel>
                <local:SnakeCanvasControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Game Over State Overlay -->
                <Border Background="#E60D1117"
                        IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:SnakeGameState.GameOver}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="GAME OVER"
                                   FontSize="20"
                                   FontWeight="ExtraBold"
                                   Foreground="#EF4444"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Score:" FontSize="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            <TextBlock Text="{Binding Score}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" />
                        </StackPanel>
                        <Button Command="{Binding TogglePlayPauseCommand}"
                                Classes="m3-filled-btn"
                                FontWeight="Bold"
                                FontSize="12.5"
                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                Padding="16,6"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Restart" Width="14" Height="14" />
                                <TextBlock Text="Play Again" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Paused State Overlay -->
                <Border Background="#B30D1117"
                        IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static local:SnakeGameState.Paused}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="PAUSED"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Press Space to Resume"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Panel>
        </Border>

        <!-- 3. Bottom Controls & Help Legend -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,10,0,0" VerticalAlignment="Center">
            <!-- Play / Pause Pill Action Button -->
            <Button Grid.Column="0"
                    Command="{Binding TogglePlayPauseCommand}"
                    Classes="m3-filled-btn"
                    FontWeight="Bold"
                    FontSize="12"
                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                    Padding="16,6"
                    Cursor="Hand">
                <TextBlock Text="{Binding ActionButtonLabel}" VerticalAlignment="Center" />
            </Button>

            <!-- Control Keys Hint -->
            <TextBlock Grid.Column="1"
                       Text="Arrows / WASD · Space"
                       FontSize="11"
                       Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>

</UserControl>
